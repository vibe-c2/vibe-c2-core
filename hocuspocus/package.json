{
  "name": "vibec2-hocuspocus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx 'src/__tests__/*.ts'",
    "start": "node dist/index.js",
    "backfill-references": "tsx src/backfill-references.ts",
    "audit-references": "tsx src/audit-references.ts",
    "backfill-search-text": "tsx src/backfill-search-text.ts"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "^2.15.0",
    "@hocuspocus/server": "^2.15.0",
    "@hocuspocus/transformer": "^2.15.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.1",
    "markdown-it": "^14.0.0",
    "markdown-it-container": "^4.0.0",
    "mongodb": "^6.12.0",
    "prosemirror-markdown": "^1.13.0",
    "prosemirror-model": "^1.23.0",
    "read-excel-file": "^9.3.10",
    "y-prosemirror": "^1.2.1",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/markdown-it": "^14.0.0",
    "@types/markdown-it-container": "^2.0.10",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
