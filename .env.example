# App
APP_STAGE_STATUS=development
APP_DEBUG=false
# JWT
JWT_SECRET_KEY=changeme_jwt_secret
# NOTE ON THE SIX LOCALHOST VALUES BELOW
# MONGO_URI, APP_RABBITMQ_HOST, APP_RABBITMQ_PORT, REDIS_HOST, REDIS_PORT and
# SEAWEEDFS_S3_ENDPOINT are deliberately NOT passed into the containers.
# docker-compose.yml hardcodes the in-network equivalents (mongodb, rabbitmq,
# redis, seaweedfs-s3), because a container cannot reach these services on
# localhost. The values here are for tooling you run on the host: `make test`,
# mongosh, redis-cli and similar. Changing them does not affect a running
# stack. Every other variable in this file is passed through, so if you add
# one, add it to the core-dev environment block too or it will silently do
# nothing.


# MongoDB
MONGO_INITDB_ROOT_USERNAME=vibec2
MONGO_INITDB_ROOT_PASSWORD=changeme_mongo
MONGO_INITDB_DATABASE=vibec2
MONGO_URI=mongodb://vibec2:changeme_mongo@localhost:27018
MONGO_DATABASE=vibec2

# RabbitMQ
RABBITMQ_DEFAULT_USER=vibec2
RABBITMQ_DEFAULT_PASS=changeme_rabbitmq
RABBITMQ_ERLANG_COOKIE=vibec2_erlang_cookie
APP_RABBITMQ_HOST=localhost
APP_RABBITMQ_PORT=5672
APP_RABBITMQ_VHOST=/

# Module lifecycle (control-plane registration + liveness)
MODULE_HEARTBEAT_INTERVAL=30s
MODULE_HEARTBEAT_GRACE_MISSES=3
MODULE_REAPER_INTERVAL=15s
MODULE_REAPER_ENABLED=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Empty means no password, which is the shipped default. Setting it now
# configures both the server and the app; previously it only reached the app
# and every Redis call failed. Redis holds the live session and refresh-token
# state, so set it on any deployment where the port is reachable.
REDIS_PASSWORD=
CACHE_ENABLED=true

# SeaweedFS
SEAWEEDFS_S3_ACCESS_KEY=vibec2
SEAWEEDFS_S3_SECRET_KEY=changeme_seaweedfs
SEAWEEDFS_S3_ENDPOINT=http://localhost:8333

# Hocuspocus (collab editing sidecar)
HOCUSPOCUS_TICKET_SECRET=changeme_hocuspocus_ticket
HOCUSPOCUS_WEBHOOK_SECRET=changeme_hocuspocus_webhook
HOCUSPOCUS_DEBOUNCE_MS=2000
# Collaborative editing capacity, enforced by the Hocuspocus sidecar.
MAX_ACTIVE_ROOMS=100
MAX_CLIENTS_PER_ROOM=20
WIKI_AUTO_BACKUP_INTERVAL=30m

# Wiki image uploads
WIKI_IMAGE_BUCKET=wiki-images
WIKI_IMAGE_MAX_SIZE=10485760
WIKI_IMAGE_MAX_DIMENSION=2560
WIKI_IMAGE_SWEEPER_INTERVAL=24h
WIKI_IMAGE_SWEEPER_GRACE=168h

# Wiki file attachments (non-image uploads)
WIKI_FILE_BUCKET=wiki-files
WIKI_FILE_MAX_SIZE=52428800
# Comma-separated MIME types to reject at upload time (empty = allow all).
WIKI_FILE_DENIED_CONTENT_TYPES=
WIKI_FILE_SWEEPER_INTERVAL=24h
WIKI_FILE_SWEEPER_GRACE=168h

# Community skills (zip bundles operators publish to each other).
# Stored opaquely and never unpacked on the server. Nothing here is ever
# garbage collected: a version somebody installed has to stay downloadable.
SKILL_BUCKET=skills
SKILL_MAX_SIZE=10485760

# Wiki attachment garbage collector (image + file sweepers).
# OFF by default. The sweepers reclaim image/file blobs that no document
# references (liveness is read from each doc's image_references/file_references
# arrays, populated by the Hocuspocus sidecar on save). Safe re-enable
# sequence after a fresh deploy:
#   1) deploy (references now recorded on every save)
#   2) backfill existing docs by running the script as a one-off container
#      from the already-pulled sidecar image:
#        docker compose run --rm hocuspocus node dist/backfill-references.js --dry-run
#        docker compose run --rm hocuspocus node dist/backfill-references.js
#      (locally, during development, `npm run backfill-references` also works)
#   3) WIKI_SWEEPER_ENABLED=true with WIKI_SWEEPER_DRY_RUN=true; inspect the
#      "would delete" logs across a couple of sweeper intervals
#   4) once the dry-run looks correct, set WIKI_SWEEPER_DRY_RUN=false
WIKI_SWEEPER_ENABLED=false
WIKI_SWEEPER_DRY_RUN=true

# Wiki transfer (export/import jobs). Uploads larger than the cap are
# refused with 413; finished jobs and their archives are deleted after the
# TTL. INSTALLATION_ID is optional and is stamped into exported bundles so a
# receiving installation can tell where a bundle came from.
WIKI_IMPORT_ZIP_MAX_SIZE=209715200
WIKI_TRANSFER_ARTIFACT_TTL=24h
INSTALLATION_ID=

# Auth — session TTLs are Go durations. AUTH_LOCAL_LOGIN_ENABLED=false hides
# the username/password form and refuses POST /login; only allowed together
# with OIDC_ENABLED=true. /enroll (first admin) is unaffected.
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=168h
AUTH_REFRESH_GRACE_TTL=10s
AUTH_CSRF_ENABLED=true
AUTH_LOCAL_LOGIN_ENABLED=true

# OIDC / single sign-on (optional). Ignored entirely unless OIDC_ENABLED=true.
# Works with any OpenID Connect provider that publishes a discovery document;
# Keycloak is the reference setup (see deploy/keycloak/ and docs/oidc-auth-design.md).
OIDC_ENABLED=false
# Issuer as printed in the provider's discovery document — for Keycloak that is
# <base>/realms/<realm>. Core fetches <issuer>/.well-known/openid-configuration.
OIDC_ISSUER_URL=http://keycloak.localhost:8180/realms/vibec2
# Confidential client. PKCE (S256) is used on top of the client secret.
OIDC_CLIENT_ID=vibe-c2
OIDC_CLIENT_SECRET=changeme_oidc_client_secret
# No callback URL is configured here. Core derives it from the request that
# starts the flow (scheme + host, honouring X-Forwarded-Proto/Host) as
#   <public origin>/api/v1/auth/oidc/callback
# and that is what you register at the provider (dev: http://localhost:8002/...,
# behind nginx: https://localhost:8443/..., prod: https://<your host>/...).
# After login the browser returns to the SPA origin it came from, provided
# that origin is listed in CORS_ALLOWED_ORIGINS; otherwise to the API origin
# (the single-origin production layout).
# "openid" is mandatory (core adds it if missing); "profile" carries the
# username claim. Add a provider-specific scope only if your roles claim needs
# one (e.g. "groups" on Authentik/Okta).
OIDC_SCOPES=openid,profile
# Label on the "Continue with ..." button.
OIDC_DISPLAY_NAME=Keycloak
# Claim used as the local username when an account is first provisioned.
OIDC_USERNAME_CLAIM=preferred_username
# Dot-path to the provider roles/groups list. Keycloak realm roles live at
# realm_access.roles, client roles at resource_access.<client-id>.roles.
OIDC_ROLES_CLAIM=realm_access.roles
# <provider-role>:<vibe-role> pairs. Vibe roles are "admin" and "user".
# Re-applied on every SSO login: the provider is the source of truth.
OIDC_ROLE_MAPPING=vibec2-admin:admin,vibec2-user:user
# Granted when no mapping matches. Leave empty to deny users with no mapped role.
OIDC_DEFAULT_ROLES=user
# Also call /userinfo and merge its claims (Keycloak keeps roles out of the ID
# token unless a mapper adds them; userinfo usually has them).
OIDC_USE_USERINFO=true
# When true, the first SSO login of a username that already exists as a LOCAL
# account adopts that account (it loses its password and becomes SSO-owned).
# Off by default: the login fails with "username taken" instead.
OIDC_LINK_EXISTING_BY_USERNAME=false
OIDC_HTTP_TIMEOUT=10s

# CORS — comma-separated list of allowed origins for the API.
# In production set this to your real frontend domain(s), e.g.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://localhost:8443

# MCP agent-key rate limits, per key per minute. Negative disables a limit.
MCP_CALLS_PER_MINUTE=120
MCP_WRITES_PER_MINUTE=30
